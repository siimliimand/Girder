# girder-runner:python-3.12 — runner image mirroring the GitHub Actions
# ubuntu-24.04 + Python 3.12 environment (impl-plan §9.1 CI parity).
#
# The agent inside runs as a non-root user whose uid maps to the worktree
# owner (see girder/sandbox/podman.py). Cache mounts target /cache/* because
# /root is not traversable for a non-root user with CAP_DAC_OVERRIDE dropped.
#
# Build:  docker build -t girder-runner:python-3.12 -f container/Dockerfile.python-3.12 container/
# (context is the container/ directory)

FROM python:3.12-slim

# Tooling the agent runtime and test suite rely on (mirrors CI runner deps).
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ripgrep fd-find procps \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s "$(command -v fdfind)" /usr/local/bin/fd

# Pre-baked test toolchain (impl-plan §9.1: deps are baked so --network=none
# testing works). PIN these to the exact versions the project's GitHub Actions
# workflow installs — `container/parity-check.sh <image> ci-env-dump.txt`
# fails the build when image and CI diverge.
#
# CI runs `uv sync` (full [project].dependencies + the pytest dev group), so
# the image must bake that whole set, not pytest alone — a suite whose
# conftest imports the project under test fails to even collect without it
# (first girder-on-girder baseline escalated exactly this way). Versions
# mirror the uv.lock resolution of 2026-09-09; re-pin when the lock moves.
RUN pip install --no-cache-dir \
        aiosqlite==0.22.1 \
        fastapi==0.141.1 \
        httpx==0.28.1 \
        jinja2==3.1.6 \
        pydantic==2.13.5 \
        pydantic-settings==2.15.0 \
        python-multipart==0.0.32 \
        pyyaml==6.0.3 \
        uvicorn==0.52.4 \
        pytest==9.1.1 \
        pytest-asyncio==1.4.0

# src-layout projects on this stack run their suite from the mounted
# worktree; this makes the mounted package importable from any commit
# (non-src layouts are unaffected — a missing path on PYTHONPATH is ignored).
ENV PYTHONPATH=/workspace/src

# Agent user; uid/gid are overridden at container start to the worktree owner.
RUN useradd --create-home --uid 10001 agent
ENV HOME=/home/agent \
    PIP_CACHE_DIR=/cache/pip \
    npm_config_cache=/cache/npm \
    CARGO_HOME=/cache/cargo

# World-traversable cache mount points (contents arrive read-only from host).
RUN mkdir -p /cache/pip /cache/npm /cache/cargo && chmod 755 /cache

WORKDIR /workspace
CMD ["sleep", "infinity"]
